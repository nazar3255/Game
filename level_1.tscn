[sub_resource type="GDScript" id="GDScript_rka8t"]
script/source = "extends \"res://enemy.gd\"

@export var trigger_distance: float = 75.0
@export var bomb_damage: int = 50

@onready var bomb_radius: Area2D = $BombaVzruvChechna

var is_exploding: bool = false
var player_target: Node2D = null

func _ready() -> void:
	player_target = get_tree().current_scene.get_node_or_null(\"Player\")
	if \"player\" in self:
		self.player = player_target
	elif \"target\" in self:
		self.target = player_target

func _process(delta: float) -> void:
	if player_target and not is_exploding:
		var distance = global_position.distance_to(player_target.global_position)
		if distance <= trigger_distance:
			start_countdown()

func _physics_process(delta: float) -> void:
	if super.has_method(\"_physics_process\"):
		super(delta)

@export var knockback_power: float = 800.0

func start_countdown():
	is_exploding = true
	
	if \"speed\" in self: self.speed = 0
	elif \"SPEED\" in self: self.SPEED = 0
		
	print(\"Камікадзе вибухає!\")
	
	var tween = create_tween()
	tween.tween_property(self, \"modulate\", Color.RED, 0.3)
	
	await get_tree().create_timer(0.3).timeout
	
	if bomb_radius and bomb_radius.has_method(\"execute_explosion\"):
		await bomb_radius.execute_explosion(bomb_damage, knockback_power)
		
	queue_free()
"

